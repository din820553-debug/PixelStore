# Set these through your hosting environment. Node does not load this example automatically.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
# Required for production; use the HTTPS origin hosting the Node server.
PUBLIC_ORIGIN=http://localhost:3000
# Comma-separated browser origins permitted to call customer endpoints.
ALLOWED_ORIGINS=https://din820553-debug.github.io
# The server stores demo storefront orders only. Payments are not connected.
